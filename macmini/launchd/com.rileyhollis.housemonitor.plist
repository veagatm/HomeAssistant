<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.rileyhollis.housemonitor</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/homeuser/Desktop/claude_code/StatusPortal/monitor.py</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HSP_API_KEY</key>
    <string>REPLACE_ME</string>
  </dict>

  <key>StartInterval</key>
  <integer>60</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/housemonitor.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/housemonitor.err</string>
</dict>
</plist>
